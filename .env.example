# Postgres connection string dari Neon (https://neon.tech)
# Gunakan connection string dengan "?sslmode=require"
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# String acak (min 32 karakter) untuk menandatangani session JWT.
# Generate contoh: openssl rand -base64 32
SESSION_SECRET="ganti-dengan-string-acak-panjang"

# Dipakai HANYA sekali oleh `npm run seed` untuk membuat akun Nutrisionist pertama.
# Setelah seed berhasil, hapus/ubah nilai ini dan JANGAN commit ke git.
SEED_NUTRISIONIST_USERNAME="nutrisionist"
SEED_NUTRISIONIST_PASSWORD="GantiPasswordIni123!"
