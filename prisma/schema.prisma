generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         String   @default("nutrisionist")
  createdAt    DateTime @default(now())
}

model MasterPerusahaan {
  id            String   @id @default(cuid())
  nama          String   @unique
  aktif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  pemeriksaan   PemeriksaanGizi[]
  requestGizi   RequestGizi[]
}

model PemeriksaanGizi {
  id                 String   @id @default(cuid())
  tanggal            DateTime
  // No. RM diisi belakangan lewat form pemeriksaan (bisa null selagi masih
  // "Menunggu Pemeriksaan"), tapi begitu terisi untuk seorang karyawan
  // (dikaitkan by nama + ID/NIK), nilai itu di-lock (read-only) di entri lain.
  noRm               String?
  namaKaryawan       String
  nikOrId            String
  perusahaanId       String
  perusahaan         MasterPerusahaan @relation(fields: [perusahaanId], references: [id])
  kantin             String   // "Mahakam" | "Belayan"
  noWhatsapp         String?  // info kontak, diisi otomatis dari request gizi
  // Field di bawah ini WAJIB diisi saat pemeriksaan (lewat tombol Edit), tapi
  // opsional saat entri pertama kali dibuat otomatis dari Request Gizi.
  jenisKelamin       String?  // "L" | "P"
  usia               Int
  beratBadan         Float?
  tinggiBadan        Float?
  persenFat          Float?
  kategoriFatGender  String?
  keteranganFat      String?
  vicFat             Float?
  keteranganVicFat   String?
  kalori             Float?
  bmi                Float?
  keteranganBmi      String?
  tindakLanjut       String?
  // "Menunggu Pemeriksaan" -> otomatis dari Request Gizi, belum lengkap.
  // "Selesai Pemeriksaan"  -> sudah dilengkapi lewat form pemeriksaan.
  status             String   @default("Menunggu Pemeriksaan")
  requestGiziId      String?  @unique
  requestGizi        RequestGizi? @relation(fields: [requestGiziId], references: [id])
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([tanggal])
  @@index([kantin])
  @@index([perusahaanId])
  @@index([status])
}

model RequestGizi {
  id             String   @id @default(cuid())
  nama           String
  umur           Int
  nikOrId        String
  perusahaanId   String
  perusahaan     MasterPerusahaan @relation(fields: [perusahaanId], references: [id])
  kantin         String   // "Mahakam" | "Belayan" -> menentukan hari konsul
  hariKonsul     DateTime
  jamKonsul      String
  noWhatsapp     String
  keluhan        String?
  status         String   @default("Baru") // Baru | Ditindaklanjuti | Selesai
  pemeriksaan    PemeriksaanGizi?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
